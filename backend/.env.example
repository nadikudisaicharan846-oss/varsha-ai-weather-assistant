# ---------------- Server ----------------
CORS_ORIGINS=http://localhost:5173
RATE_LIMIT_PER_MINUTE=60
DEFAULT_CITY=Hyderabad

# ---------------- Weather ----------------
# open-meteo (free, no key) | mock
WEATHER_PROVIDER=open-meteo
WEATHER_API_KEY=your_weather_api_key      # not needed for Open-Meteo
# If the live provider is down, serve clearly-labelled sample data instead of failing
ALLOW_MOCK_FALLBACK=true
CACHE_TTL_SECONDS=600
HTTP_TIMEOUT_SECONDS=15
# Optional JSON file overriding alert thresholds (see app/alerts/thresholds.json)
ALERT_THRESHOLDS_FILE=

# ---------------- AI (optional: the app works without it, using rule-based answers) ----------------
# none | openai | anthropic
AI_PROVIDER=none
AI_API_KEY=your_ai_api_key
# openai: e.g. gpt-4o-mini   | anthropic: e.g. claude-sonnet-5-5
AI_MODEL=
# OpenAI-compatible endpoints (leave empty for OpenAI). Gemini example:
# AI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai
AI_BASE_URL=
AI_TIMEOUT_SECONDS=30

# ---------------- Voice (optional server-side STT/TTS; browser speech is used by default) ----------------
# browser | openai
VOICE_PROVIDER=browser
VOICE_STT_MODEL=whisper-1
VOICE_TTS_MODEL=tts-1
VOICE_TTS_VOICE=alloy

# ---------------- Database (optional; SQLite by default, PostgreSQL URLs also work) ----------------
DATABASE_URL=sqlite:///./varsha.db
